<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WirelessCanvasRGB</AssemblyName>
    <RootNamespace>WirelessCanvas</RootNamespace>
    <Product>WirelessCanvas RGB</Product>
    <Authors>Sterax</Authors>
    <Copyright>Copyright (c) 2026 Sterax; based on lian-li-linux, Copyright (c) 2026 sgtaziz</Copyright>
    <RepositoryUrl>https://github.com/qdellp/wirelesscanvas-rgb</RepositoryUrl>
    <Version>0.13.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Translations.json" />
    <None Include="native/tinyuz.dll" TargetPath="tinyuz.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="native/tuz-dec.dll" TargetPath="tuz-dec.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../upstream/crates/lianli-devices/tests/fixtures/*.yuz" Link="test-fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- Linux-only dependency of LibreHardwareMonitorLib: not needed on Windows, so it is not shipped. -->
    <PackageReference Include="Mono.Posix.NETStandard" Version="1.0.0" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
</Project>
